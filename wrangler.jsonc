{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-tg-checkin",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // 用 CLI 部署时保留 Dashboard 里手动加的变量/密钥（不要被覆盖掉）
  "keep_vars": true,
  // 自定义构建：任何 deploy / dev 都会先跑一遍 esbuild（见 build.mjs）
  "build": {
    "command": "node build.mjs",
    "watch_dir": "src",
    "cwd": "."
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TG_AGENT", "class_name": "TgAgent" }]
  },
  // 首次部署时创建 SQLite 版 Durable Object（session / 任务 / 日志都在里面）
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TgAgent"]
    }
  ],
  // 关闭 Workers Logs（可观测性采集）：排障请看管理界面的「日志」页，
  // 那是我们自己写进 DO SQLite 的执行记录；Worker 平台的日志按请求采样，
  // 免费额度下既不便宜也没必要。
  "observability": {
    "enabled": false
  },
  // 兜底：正常调度靠 DO alarm，这里只是保险（例如 alarm 丢失时补一次）
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
