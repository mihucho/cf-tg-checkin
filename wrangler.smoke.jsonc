{
  // 只给 `npm run smoke` 用的最小配置：不含 Durable Object / 静态资源
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-tg-checkin-smoke",
  "main": "dist/smoke.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "node build.mjs --smoke",
    "watch_dir": "src"
  }
}
